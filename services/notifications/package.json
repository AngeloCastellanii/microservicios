{
  "name": "@acadflow/notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "tsx ../../scripts/run-with-env.ts prisma db push",
    "db:seed": "tsx prisma/seed.ts",

    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acadflow/proto": "workspace:*",
    "@acadflow/rpc-wrapper": "workspace:*",
    "@acadflow/shared": "workspace:*",
    "@grpc/grpc-js": "^1.13.4",
    "@prisma/client": "^6.8.2",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
