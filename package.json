{
  "name": "acadflow",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma académica con microservicios gRPC (AcadFlow)",
  "scripts": {
    "build": "pnpm -r run build",
    "build:proto": "pnpm --filter @acadflow/proto build",
    "dev:db": "docker compose up -d",
    "dev:db:down": "docker compose down",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.2.2"
}
